{
  "name": "dsh-tailscale-gateway",
  "version": "0.1.2",
  "description": "DSH plugin bundle: expose the official DSH web GUI to your tailnet (auto-detects the Tailscale IP, forwards a LAN port to the loopback-bound GUI, admits the phone Host authority).",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "tailscale",
    "gateway",
    "remote-access"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scorpio0v0/dsh-tailscale-gateway.git"
  },
  "homepage": "https://github.com/scorpio0v0/dsh-tailscale-gateway#readme",
  "files": [
    "src",
    "cordis.bundle.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.bundle.yml"
      ],
      "platforms": [
        "win32"
      ]
    }
  }
}
